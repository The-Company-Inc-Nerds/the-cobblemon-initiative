        DialogData: {
            Type: "BASIC",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Company property. Authorized personnel and shareholders. You are neither. Almost certainly neither."
                        },
                        {
                            Text: "The tower is not open to foot traffic. It has never been open to foot traffic. Please stop looking at the door like it owes you something."
                        },
                        {
                            Text: "You look like someone. I am not paid to finish that sentence, and I would like it out of my head now."
                        },
                        {
                            Text: "(He checks your face against something laminated, twice, then holds the laminate a little closer to his chest and stares straight ahead.)"
                        }
                    ],
                    Name: "Security Associate Voss",
                    Label: "default"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "fields_liberated_gte_6"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "badges_gte_7"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Floor access unlocked... have we escorted you before? We have not. I would remember. I am going to stop thinking about this."
                        },
                        {
                            Text: "(He steps aside. He does it the way a door opens on a timer — nothing personal, nothing decided, and his eyes track you the whole way in.)"
                        },
                        {
                            Text: "The list updated itself last night. Nobody upstairs signs things at night. Go in, then, since apparently you were always going to."
                        }
                    ],
                    Name: "Security Associate Voss",
                    Label: "stand_down"
                }
            ]
