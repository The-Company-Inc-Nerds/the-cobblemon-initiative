        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_found_kalahar_trainer_2"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "Reach out",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative kalahar reach"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "reach_button"
                        },
                        {
                            Name: "Step back",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "A ruin-hand of the Reach crouches over the sand, sifting with the patience of someone who belongs here. Or of something that never gets tired."
                        },
                        {
                            Text: "The wind worries at their coat. In the shimmer you cannot tell if the cloth is moving or the light is."
                        },
                        {
                            Text: "Every figure in this heat wavers like a reflection on hot glass - the true ones and the sand-made ones alike. Reach out and see which this is."
                        }
                    ],
                    Name: "the air bends",
                    Label: "mirage"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_kalahar_trainer_2"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Onward",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Buried things do not stay buried around you, do they. Go deeper - Juno and Vince hold the inner cut."
                        }
                    ],
                    Name: "Dustin - the dig continues",
                    Label: "beaten"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Battle Ruin Maniac Dustin",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_kalahar_trainer_2"
                                            }
                                        ]
                                    },
                                    Cmd: "say The ruins remember you. Walk on."
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_kalahar_trainer_2"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs attach rctmod:kalahar_trainer_2 @s"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_kalahar_trainer_2"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs battle GEN_9_SINGLES @s vs rctmod:kalahar_trainer_2 onwin {1: ['tag @1 add defeated_kalahar_trainer_2', '@2 say A significant find walks past me and I do not even get to catalog it. Dig on.', 'tag @1 add found_kalahar_trainer_2'], 2: ['@1 say The old stones have been winning since before the desert had a name. Do not take it personally.']}"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_defeated_kalahar_trainer_2"
                                }
                            ],
                            Label: "battle_button"
                        },
                        {
                            Name: "Not yet",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "I dig for ruins, not for glory. But I will not let a soft challenger pass the ruins I guard."
                        },
                        {
                            Text: "Second of the diggers. The sand answers to me here. Ready when you are."
                        },
                        {
                            Text: "These ruins predate the desert - the sand blew in later, as a preservative. Juno disputes this because she is envious of my methods."
                        },
                        {
                            Text: "(He presents a pottery shard with enormous ceremony.) Late imperial. Possibly a flowerpot. The line between those is thinner than people admit."
                        }
                    ],
                    Name: "Dustin - second of the diggers",
                    Label: "default"
                }
            ]
        },
