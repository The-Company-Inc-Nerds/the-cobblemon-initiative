        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Begin the hunt",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative kalahar start"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "start_button"
                        },
                        {
                            Name: "Understood",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Challenger. Before you ask - the hollow is empty. Leader Gaia is still inside, but her students scattered the moment word of you reached the Reach."
                        },
                        {
                            Text: "It is an old desert trick. The diggers, Jr. Apprentice Dune, and Apprentice Terra each threw a handful of mirages of themselves across town. One of each is real - the rest are heat and expectation."
                        },
                        {
                            Text: "Find the true Dune and the true Terra and beat them, and Gaia will see you. Hunt down the real diggers too and Gaia fights tired - her herd will have spent the day chasing yours."
                        },
                        {
                            Text: "One warning. Reach for a mirage that is not real and it may just drift apart as sand - or it may turn on you. A mirage casts no shadow. That is the only tell the desert gives."
                        }
                    ],
                    Name: "the guide of the Reach",
                    Label: "intro"
                }
            ]
        },
