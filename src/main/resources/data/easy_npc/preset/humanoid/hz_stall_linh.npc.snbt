                    ],
                    Texts: [
                        {
                            Text: "The steady drawer — tempers that hold. Impish and Bold for the walls, Calm and Careful for the patience behind them. Nothing in this drawer ever starts a fight. Nothing in it loses one quickly either."
                        }
                    ],
                    Name: "Linh Hua — the steady drawer",
                    Label: "drawer_steady"
