        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_9_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "Keep the terraces open",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Hear the quiet? No clipboard on the wind, no clerk counting the terraces off a shelf. My family cut these steps into the ridge one summer at a time, generation over generation, so the thin air could still grow bread. Not for the Board to ask about by name."
                        },
                        {
                            Text: "The estate papers blew off the top terrace and I let the mountain have them. Rest at my step when the ridge road tires you - travelers eat free this high now, and so do their teams."
                        }
                    ],
                    Name: "Odd - the steps are ours",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_9"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_9_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - cut it loose",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_9}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"HIGHFIELD ESTATE LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Odd cuts the terrace wire loose step by step - Highfield Estate runs free, and the crown of the ridge feeds the mountain road instead of the Board.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The Manager walked off the top terrace with his clipboard held against the wind and no crew to hold the shelf. That means the paper is dead and only the fence is left - and a fence is just wire strung across a step once nobody official is holding it up. Say the word and I cut it loose."
                        }
                    ],
                    Name: "Odd - the fence is next",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the top terrace",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "This was a family estate before it was an asset - steps cut into the ridge shelf, a shed at the top terrace, and nobody counting who climbed the road. Then the Company strung wire across every step and started calling my harvest a yield the mountain owed them."
                        },
                        {
                            Text: "Two of them hold the parcel. The officer at the fence will stop you at the wire and call it a conversation. Doran runs the whole terraced string from the top shelf and has never once looked up from his clipboard, though the Board asks after this field by name."
                        },
                        {
                            Text: "I do not want a war. I want my terraces back, my shed door open, and the ridge road stopping here because the bread is worth the climb. Deal with the clipboards and I will handle the wire myself."
                        }
                    ],
                    Name: "Odd",
                    Label: "default"
                }
            ]
        },
