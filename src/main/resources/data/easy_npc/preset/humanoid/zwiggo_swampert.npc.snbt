                        },
                        {
                            Name: "Not yet, big fellow",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "later_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Zwig? (The swampert hauls itself half onto the quay and looks you over, from boots to eyes and back. It seems to have already decided something about you.)"
                        },
                        {
                            Text: "(It plants both fins on the stone and waits, tail dripping harbour water. Down the quay a deckhand is very carefully not watching.)"
                        },
                        {
                            Text: "Zwig-go. (It says it the way you would offer a handshake.)"
                        }
                    ],
                    Name: "Zwiggo",
                    Label: "default"
                }
