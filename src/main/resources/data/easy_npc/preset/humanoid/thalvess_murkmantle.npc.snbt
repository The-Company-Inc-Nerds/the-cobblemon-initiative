            {}
        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "thalvess_traded"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "A fair trade",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The little fog-fish is settling into my tank already — ugliest thing in the marsh and I say it with love. And you walked off carrying venom. Point that Mareanie at anything with wings and it will thank you for the introduction. A fair trade. My grandmother would have written it in the good ledger."
                        },
                        {
                            Text: "Come back when Gaviota is behind you. If that Feebas of mine ever turns into what Feebas turn into, I will name the tank after you."
                        }
                    ],
                    Name: "Thalvess — a fair exchange",
                    Label: "traded"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Trade a Feebas for a Mareanie",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative trade feebas mareanie 25 thalvess_traded"
                                },
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_thalvess_traded"
                                }
                            ],
                            Label: "trade_button"
                        },
                        {
                            Name: "Not today",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You have the look of someone about to walk into the Charm Badge undergunned. Fairies fear little in this world — but they fear POISON, and the marsh grows a lovely one. So here is the only deal I keep these days: bring me a Feebas — the fog-fish, you can pull one out of the marsh water yourself if you are patient — and I will trade you something with real venom in it."
                        },
                        {
                            Text: "One fog-fish for one Mareanie. She is uncommon, she is mean, and a single jab from her ruins a Fairy leaders whole afternoon. I keep the fish, you keep your badge run alive. The marsh runs on favours, and this is a good one — no coin changes hands at my counter anymore."
                        }
                    ],
                    Name: "Thalvess Murkmantle",
                    Label: "default"
                }
            ]
        },
