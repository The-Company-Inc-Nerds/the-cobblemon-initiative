                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "A field down the road came home to its own dirt. The mycelium felt it before the banner finished turning — we always feel it first."
                        },
                        {
                            Text: "A Company flag came down somewhere and the whole ground exhaled. Spores travel, trainer. So does news."
                        }
                    ],
                    Name: "Maslen — spores carry news",
                    Label: "post_liberation"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_r3_trainer_shroom"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You are through the hollow. The spores remember your shape now — pass as often as you like."
                        },
                        {
                            Text: "Beaten fair, and I will stand here and grow on it. That is not a complaint. Growing on things is the whole job."
                        }
                    ],
                    Name: "Maslen — beaten",
                    Label: "beaten"
                },
