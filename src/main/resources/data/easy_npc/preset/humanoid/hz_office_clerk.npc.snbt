        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "hz_minutes_heard"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "You saw nothing",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You were near the top-floor door during the reading. I did not see you, I did not log you, and I would appreciate it enormously if both of those things stayed true."
                        },
                        {
                            Text: "Whatever you heard up there, the minutes do not exist until they are countersigned, and I am very slow with a pen when I want to be."
                        }
                    ],
                    Name: "Anong — nothing was read",
                    Label: "post_minutes"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Leave the desk",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Records. Everything the eastern district signs for passes this desk twice — once when it is promised, once when it is adjusted. The gap between those two entries is called operations, and I am not paid to name it anything else."
                        },
                        {
                            Text: "The clinic shipment goes out of here every month. Six boxes leave my ledger, four arrive at the Center, and every count in between is signed, sealed, and correct. The nurse said no to a folder once. The arithmetic has been saying no back ever since."
                        },
                        {
                            Text: "The mezzanine is for account review. If you are looking for the manager, the top floor is by appointment — and mind how you go. Everyone on this floor logs foot traffic. It is the one metric we never miss."
                        }
                    ],
                    Name: "Anong — records and adjustments",
                    Label: "default"
                }
            ]
        },
