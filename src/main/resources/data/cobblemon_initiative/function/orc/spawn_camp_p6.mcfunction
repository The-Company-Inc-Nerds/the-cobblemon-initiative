# Orc camp P6 (644 139 3124) — far-west valley camp, mid tier (minor spoils on clear).
# Run positioned at the pin from orc/tick; latch set FIRST (one-shot raise). 5 mobs:
# two axe vindicators in leather-and-chain, two husk marauders, War-Chief in full iron at
# 48 HP. Drop-chance loot carry (0.25f armor / 0.5f hands, husks CanPickUpLoot 0b).
scoreboard players set #orc_camp_p6 ci_ambient 1
title @a[distance=..48] actionbar [{"text":"War-drums on the ridge — a raider camp stirs","color":"red"}]
execute positioned ~-4 ~1 ~2 run summon minecraft:vindicator ~ ~ ~ {Tags:["orc_camp_p6","ci_orc"],PersistenceRequired:1b,CustomName:'{"text":"Orc Raider"}',HandItems:[{id:"minecraft:iron_axe",count:1},{}],HandDropChances:[0.5f,0.0f],ArmorItems:[{},{},{id:"minecraft:chainmail_chestplate",count:1},{}],ArmorDropChances:[0.25f,0.25f,0.25f,0.25f]}
