            {}
        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_4_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "The dust remembers",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The water runs in the ditch again — real water, not a promise inked on a clipboard. You gave a dry-country hand these rows back. Dryrow is a field again, not a line item that evaporates. The dust remembers a kindness far longer than the rain ever did."
                        },
                        {
                            Text: "Grain for the town now, not for a ledger that files a drought under adjustment. If the Company drops another fence on this steading, the whole dry country will be waiting for them. Mind the road east — Kalahar is thirsty and Company-watched both."
                        }
                    ],
                    Name: "Tamar - the water runs",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_4"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_4_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - let the water run",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_4}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"DRYROW LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Tamar breaks the fence and turns the water loose - the Dryrow Steading runs free, and the dry country takes its field back.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold the water a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You moved that Manager off the granary. I watched the whole bout from the furrow with my heart in my throat. Say the word and I break the fence and turn the water loose — Dryrow takes its field back the moment the ditch fills."
                        }
                    ],
                    Name: "Tamar - say the word",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the granary",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Keep it low out here. That is a Company Manager up on the granary, and this steading fed the dry country three generations before he stapled a receipt to the well. Now I sign for the right to walk my own rows."
                        },
                        {
                            Text: "I farmed this dust before the fence went up. The Company calls it verification. The dry rows and the empty ditch call it dying on a schedule, and I can do nothing while that man holds the granary."
                        },
                        {
                            Text: "They fenced the well first, then the field, then me. If somebody were to move that Manager off the granary, the water could run inside the hour. I did not say that out loud."
                        },
                        {
                            Text: "Odd thing - the Manager squints at you like a memo he was told to burn. Out here you learn not to ask what the Company forgets on purpose. The desert keeps enough secrets already."
                        }
                    ],
                    Name: "Tamar",
                    Label: "default"
                }
            ]
        },
