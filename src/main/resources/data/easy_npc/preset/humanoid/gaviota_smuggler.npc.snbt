            {}
        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_3_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "The coast remembers",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The tide runs where it likes again and the salt-rows stand up straighter every dawn. You gave an old hand her coast back — Westwind is a field again, not a number that floats. It will not forget it, and neither will I."
                        },
                        {
                            Text: "Grain by sea for the town now, not for a ledger. If the Company floats another fence out here, they will find the whole dock against them. Mind the road east — the dry country is Company ground too."
                        }
                    ],
                    Name: "Sable - the tide runs",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_3"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_3_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - open the sea-gate",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_3}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"WESTWIND LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Sable hauls the sea-gate wide - the Westwind Fields run free, and the coast takes its field back.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold the tide a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You moved that Manager off my silo. I watched the whole bout from the dyke and I have not breathed this easy in a season. Say the word and I haul the sea-gate wide — Westwind takes its field back the moment the tide runs."
                        }
                    ],
                    Name: "Sable - say the word",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the silo",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Keep your voice down at the dock. That is a Company Manager up on my silo, and these salt-rows fed the coast for three generations before he stapled a receipt to the tide. Now I sign for the right to walk my own dyke."
                        },
                        {
                            Text: "I worked this wet field before the fence went up. The Company calls it verification. The rice and the sea call it drowning on a schedule, and I can do nothing while that man holds the silo."
                        },
                        {
                            Text: "They fenced the water first, then the field, then me. If somebody were to move that Manager off my silo, the sea-gate could run inside the hour. I did not say that out loud."
                        },
                        {
                            Text: "Strange thing - the Manager squints at you like a memo he was told to shred. I stopped asking what the Company forgets on purpose. Safer, on this coast, not to know."
                        }
                    ],
                    Name: "Sable",
                    Label: "default"
                }
            ]
        },
