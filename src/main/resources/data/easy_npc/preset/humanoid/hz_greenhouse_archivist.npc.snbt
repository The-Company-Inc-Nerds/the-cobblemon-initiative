        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Browse the wool shelf",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "shelf"
                                }
                            ],
                            Label: "shelf_button"
                        },
                        {
                            Name: "Ask about the ledger",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"One Wooloo. Cloud, down at the apricorn cart these days — Guo still shears, Grandfather used to bale, I card and file by weight and nap. Four years, zero discrepancies. The Company counts wheat, not wool, and I plan to keep these records exactly that boring.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "ledger_button"
                        },
                        {
                            Name: "Leave the loft",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Shu. I keep the shelf now — Grandfather minds the door and the opinions downstairs, and the counting came up here with me. White by the bale, black by the bundle, weighed twice, because once is a guess."
                        },
                        {
                            Text: "I grew up on this floor sorting fleeces. Long staple left, short staple right, burrs go back to the sheep for rework. A wool shelf is just an archive with better insulation, and I do not misfile."
                        },
                        {
                            Text: "Every fleece is off the one flock in this valley the Company has never audited. Sheep do not file yield reports. I checked. Twice."
                        }
                    ],
                    Name: "Shu — the wool shelf",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "White Wool x8 — 120 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_wool_white"
                                }
                            ],
                            Label: "buy_wool_white_button"
                        },
                        {
                            Name: "Black Wool x4 — 130 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_wool_black"
                                }
                            ],
                            Label: "buy_wool_black_button"
                        },
                        {
                            Name: "Shears — 300 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_shears"
                                }
                            ],
                            Label: "buy_shears_button"
                        },
                        {
                            Name: "Back to Shu",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        },
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The shelf. White by the bale, black off the one contrary sheep on the north plot, and a spare pair of shears — Grandfather retired with two, and the display copy is not for sale."
                        },
                        {
                            Text: "Flat prices, posted nowhere, changed never. The index does not come up these stairs."
                        }
                    ],
                    Name: "Shu — bales and bundles",
                    Label: "shelf"
                }
            ]
        },
