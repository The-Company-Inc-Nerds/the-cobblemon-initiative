        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_6_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "Keep the gate open",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Hear that? Nothing. No hum on the wire, no clipboard scratching. My mother strung the first fence on this parcel to keep ponyta out of the wheat, not to keep people off the road - and as of today it does her job again."
                        },
                        {
                            Text: "The Company paperwork went into the stove, where it finally warmed something. Stop by any time - travelers on the pylon road eat free at my gate, and so do their teams."
                        }
                    ],
                    Name: "Imara - the rows run free",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_6"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_6_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - open the gate",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_6}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"FENCELINE ACRES LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Imara cuts the Company fence strand by strand - Fenceline Acres runs free, and the rows feed the road instead of the tower.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The Manager walked out of the transformer shed holding her clipboard like a lifeboat. That means the paper is dead and only the fence is left - and a fence is just wire once nobody official is holding it up. Say the word and I cut it."
                        }
                    ],
                    Name: "Imara - the fence is next",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the fence",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "This was a family field before it was an asset. Wheat in the rows, a kettle on the gate post, and nobody counting who walked through. Then the Company strung new wire under their pylons and started calling my harvest a yield."
                        },
                        {
                            Text: "Two of them hold the parcel. Kade works the fence - he will stop you at the wire and call it a conversation. Mira runs the whole string from the transformer shed and has never once looked up from her clipboard."
                        },
                        {
                            Text: "I do not want a war. I want my gate back, my kettle on the post, and wagons that stop because the bread smells right. Deal with the clipboards and I will handle the fence myself."
                        }
                    ],
                    Name: "Imara",
                    Label: "default"
                }
            ]
        },
