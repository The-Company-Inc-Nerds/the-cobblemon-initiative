        name: "Leader Bruno",
        variantType: "STEVE",
        version: "1.0.0"
    },
    data: {
        ActionData: {
            ActionEventSet: {
                ON_INTERACTION: [
                    {
                        Type: "OPEN_DEFAULT_DIALOG"
                    }
                ]
            }
        },
        ArmorDropChances: [0.08500000089406967f, 0.08500000089406967f, 0.08500000089406967f, 0.08500000089406967f],
        ArmorItems: [
            {},
            {},
            {},
            {}
        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_deepcore_leader"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Thank you, Leader",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The Iron Badge is on you and it fits. You hit like someone who has had everything taken and decided to take it back. I respect that."
                        },
                        {
                            Text: "Funny. The grey suits asked about you before you ever got here. Said you were important once. I told them everyone is important to somebody. They did not laugh."
                        }
                    ],
                    Name: "Bruno — after defeat",
                    Label: "after"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_deepcore_apprentice"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_mc_gym4_done"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_cfg_gym_gate_off"
                        }
                    ],
                    Priority: 18,
                    Buttons: [
                        {
                            Name: "I will go do that",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You want the Iron Badge? Then go earn some iron of a harder kind. Take a pick into the deep dark and cut a diamond out of the stone with your own two hands."
                        },
                        {
                            Text: "Fighting-types close the distance and dig in. No shortcuts down there and none up here. Come back when you have got the stone to show for it."
                        }
                    ],
                    Name: "Bruno — prove yourself in the world",
                    Label: "mc_locked"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_deepcore_apprentice"
                        }
                    ],
                    Priority: 15,
                    Buttons: [
                        {
                            Name: "Challenge the Gym",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_deepcore_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "say Iron Badge already on you. Stand tall out there. The grey suits in this city talk soft and hit softer, but they never stop counting."
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_deepcore_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "cutscene play deepcore_leader_intro function cobblemon_initiative:gym/engage_deepcore_leader"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "yes_button"
                        },
                        {
                            Name: "I need to prepare",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Deepcore City, and I am Leader Bruno. Fighting-types do not ask permission. They close the distance and they make their point with both fists."
                        },
                        {
                            Text: "No tricks down here. Just you, me, and who can stay standing. Win that and the Iron Badge is yours."
                        }
                    ],
                    Name: "Bruno — challenge",
                    Label: "ready"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_dc_track_full"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_dc_track_pit"
                        }
                    ],
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Face the whole dojo",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add dc_track_full"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Gauntlet is live. The floor masters are hunting you now — when one closes in, the fight is on. Drop them in any order, then clear the pit and return to Bruno.\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "track_full_button"
                        },
                        {
                            Name: "Just the apprentices — straight to the pit",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add dc_track_pit"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:gym/engage_deepcore_pit"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "track_pit_button"
                        },
                        {
                            Name: "Let me think",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Deepcore City, and I am Leader Bruno. My gym does not queue politely. Four masters roam the floor and once the Gauntlet is live they hunt you down — the ambush IS the bout. The pit at the bottom never moves: Ken and Striker together, two on two, with a second from the gym at your corner. Clear the pit and I will fight you. How much floor you carry first is your call."
                        },
                        {
                            Text: "One question before anything else, challenger: how much do you want to bleed on the way down? Take the whole dojo and the floor masters come for you where you stand — every one you drop leaves the pit more tired. Or walk past them straight to my apprentices at full strength, right now. Either road ends in the pit, and the pit ends at me."
                        }
                    ],
                    Name: "Bruno — choose your Gauntlet",
                    Label: "default"
                },
                {
                    Priority: 8,
                    Buttons: [
                        {
                            Name: "Send me back to the pit",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:gym/engage_deepcore_pit"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "dc_track_pit"
                                },
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_defeated_deepcore_apprentice"
                                }
                            ],
                            Label: "pit_relaunch_button"
                        },
                        {
                            Name: "I will be back",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The road is chosen but the pit has not cleared you yet. Ken and Striker fight as one side, and the gym lends you a second so nobody stands alone down there."
                        },
                        {
                            Text: "Nothing more to say until the pit says it for you. Walk down, take the bout, walk back out standing."
                        }
                    ],
                    Name: "Bruno — the pit still waits",
                    Label: "track_status"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_deepcore_apprentice"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "deepcore_tower_gte_4"
                        }
                    ],
                    Priority: 17,
                    Buttons: [
                        {
                            Name: "Challenge the Gym",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_deepcore_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "say Iron Badge already on you. Stand tall out there. The grey suits in this city talk soft and hit softer, but they never stop counting."
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_deepcore_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "cutscene play deepcore_leader_intro function cobblemon_initiative:gym/engage_deepcore_leader_weak"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "yes_button"
                        },
                        {
                            Name: "I need to prepare",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Kenji. Rio. Every trainer on the floor, laid out in an afternoon — my crew spent the day nursing bruises instead of drilling. You have already knocked the wind out of this gym, challenger. Come take the rest."
                        }
                    ],
                    Name: "Bruno — challenge",
                    Label: "ready_weakened"
                }
            ]
        },
