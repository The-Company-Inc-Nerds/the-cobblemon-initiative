# Orc camp P2 (1299 212 3649) — the summit war-camp, hardest of the eight (highest ridge,
# top of the menace ladder). Run positioned at the pin from orc/tick when a player closes
# within 48. Latch set FIRST so the raise is one-shot. Ring uses world-axis offsets +1 y
# (night_watch idiom — mobs settle rather than suffocate). 6 mobs: three axe vindicators
# in iron, two husk marauders, and the War-Chief (full iron, 60 HP via attributes).
# Gear carries the drop-chance loot (ArmorDropChances 0.25f / HandDropChances 0.5f);
# CanPickUpLoot 0b on husks so they never eat their own drops or the spoils.
scoreboard players set #orc_camp_p2 ci_ambient 1
title @a[distance=..48] actionbar [{"text":"War-drums on the ridge — a raider camp stirs","color":"red"}]
execute positioned ~4 ~1 ~3 run summon minecraft:vindicator ~ ~ ~ {Tags:["orc_camp_p2","ci_orc"],PersistenceRequired:1b,CustomName:'{"text":"Orc Raider"}',HandItems:[{id:"minecraft:iron_axe",count:1},{}],HandDropChances:[0.5f,0.0f],ArmorItems:[{},{id:"minecraft:chainmail_leggings",count:1},{id:"minecraft:iron_chestplate",count:1},{id:"minecraft:iron_helmet",count:1}],ArmorDropChances:[0.25f,0.25f,0.25f,0.25f]}
execute positioned ~-5 ~1 ~2 run summon minecraft:vindicator ~ ~ ~ {Tags:["orc_camp_p2","ci_orc"],PersistenceRequired:1b,CustomName:'{"text":"Orc Raider"}',HandItems:[{id:"minecraft:iron_axe",count:1},{}],HandDropChances:[0.5f,0.0f],ArmorItems:[{id:"minecraft:iron_boots",count:1},{},{id:"minecraft:iron_chestplate",count:1},{id:"minecraft:chainmail_helmet",count:1}],ArmorDropChances:[0.25f,0.25f,0.25f,0.25f]}
execute positioned ~3 ~1 ~-4 run summon minecraft:vindicator ~ ~ ~ {Tags:["orc_camp_p2","ci_orc"],PersistenceRequired:1b,CustomName:'{"text":"Orc Raider"}',HandItems:[{id:"minecraft:iron_axe",count:1},{}],HandDropChances:[0.5f,0.0f],ArmorItems:[{},{},{id:"minecraft:chainmail_chestplate",count:1},{id:"minecraft:iron_helmet",count:1}],ArmorDropChances:[0.25f,0.25f,0.25f,0.25f]}
execute positioned ~-3 ~1 ~-3 run summon minecraft:husk ~ ~ ~ {Tags:["orc_camp_p2","ci_orc"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,CustomName:'{"text":"Orc Marauder"}',HandItems:[{id:"minecraft:iron_sword",count:1},{}],HandDropChances:[0.5f,0.0f],ArmorItems:[{},{},{id:"minecraft:chainmail_chestplate",count:1},{id:"minecraft:iron_helmet",count:1}],ArmorDropChances:[0.25f,0.25f,0.25f,0.25f]}
