        DialogData: {
            Type: "BASIC",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "I mind the porch lamps. Only the porch — the big round belongs to the lamplighter and her glowstone, and this house does not poach honest work."
                        },
                        {
                            Text: "The town thinks the eldest is a nice old lady with charms. She is. She is also older than the boardwalk, and the charms work. Both things true at once — that is the marsh way of filing."
                        },
                        {
                            Text: "The Company counts everything, the eldest says. So we taught the house not to add up. Guests come in twice and leave once, and somewhere south a ledger develops a headache."
                        }
                    ],
                    Name: "Wick",
                    Label: "default"
                }
            ]
        },
