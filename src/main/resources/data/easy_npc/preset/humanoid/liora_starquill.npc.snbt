        DialogData: {
            Type: "CUSTOM",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Heal my team - posted rate",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/heal_paid"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add met_mm_nurse"
                                },
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "healed"
                                }
                            ],
                            Label: "heal_button"
                        },
                        {
                            Name: "Use the PC",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:pc/open"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "pc_button"
                        },
                        {
                            Name: "Not right now",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add met_mm_nurse"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Welcome to the Mystic Marsh Center - mind the boardwalk, it weeps at the joints. Full restore is the posted rate, no account card needed, and the tea by the door is free whether you can pay or not. Marsh hospitality."
                        },
                        {
                            Text: "You look like the road chewed you up. Willowmire Path does that. Set your team down, the schedule is on the post, and the stars will still be where I charted them when you wake."
                        },
                        {
                            Text: "Nurse by day, wisp-charter by night - in this town those are the same job. The lights mark where the boardwalk lies and where the water tells the truth. I mend whatever ignored the difference."
                        }
                    ],
                    Name: "Liora Starquill",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Thank you, Nurse",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "There - rested and mended, billed at the posted rate, same as everyone who crosses my boards. Mind the wisps on the way out. They lead the tired ones in circles - unless you carry my map."
                        },
                        {
                            Text: "Good as new. Quarry Road south is long and Deepcore at the end of it is longer. Rest here while the fen lets you."
                        }
                    ],
                    Name: "Liora Starquill - rested",
                    Label: "healed"
                }
            ]
        },
