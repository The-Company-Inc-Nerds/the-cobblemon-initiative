        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "warden_hunt_active"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "File the Warden's Cache",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/warden_ossa/deposit"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "file_button"
                        },
                        {
                            Name: "Still digging",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "later_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The bearing is chalked. Walk out onto the open sand and watch for the dust standing where no wind should raise it - the cache is under the drift there. Dig it out, bring me the sealed box, and the records will pay it face."
                        },
                        {
                            Text: "Still unfiled, then. The desert is not going anywhere, and neither is my drawer. Bring me the Warden's Cache when you have it out of the sand - I file it, I pay you, and I chalk you the next bearing when you want one."
                        }
                    ],
                    Name: "Ossa - the cache is out there",
                    Label: "active"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Chalk me a bearing to a cache",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add warden_hunt_active"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/kalahar_hunt/arm_warden"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "start_button"
                        },
                        {
                            Name: "Later",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "later_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Ossa. I keep the old land records - what the dunes have not eaten. Half my ledger is caches the old Reach buried against bad seasons and never came back for."
                        },
                        {
                            Text: "The desert is full of them, and I pay honest coin for every one you file. The Warden's Deposit is the iron chest at my elbow - anything the sand gives up goes in there and into the ledger. The Company would call paying for old paper inefficient sentiment, which is how I know it is right."
                        },
                        {
                            Text: "Say the word and I will chalk you a bearing to one. Walk it out, dig the sealed box out of the drift, and bring it back to this drawer. There is always another cache; the Reach buried more than it ever dug back up."
                        }
                    ],
                    Name: "Warden Ossa",
                    Label: "default"
                }
            ]
        },
