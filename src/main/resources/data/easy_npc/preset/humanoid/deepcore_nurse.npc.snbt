        CustomNameVisible: 1b,
        DialogData: {
            Type: "BASIC",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Rilka. I used to run the healing desk out of this shack until somebody noticed it was a toolshed on the quarry rim and not, in fact, the Pokemon Center. The Center is the big building east side, Orrin has the desk now. I got the view and the quiet and I am not sure I lost the trade."
                        },
                        {
                            Text: "Watch your footing on the rim, the gravel here rolls like it is paid to. I have watched three carts and one supervisor go over that edge, and the town only mourned the carts."
                        },
                        {
                            Text: "You want your team seen to, go east and find Orrin at the Center - the oil peddler, yes, the one with the counter manner. Steadiest hands in Deepcore and he posts an honest rate, which around here counts as a miracle twice over."
                        },
                        {
                            Text: "I can read this whole town from the quarry rim. Who limps, who hurries, which crews come up short-handed and which come up short-paid. You do not need a ledger up here. You just need to watch who walks careful."
                        }
                    ],
                    Name: "Rilka",
                    Label: "default"
                }
            ]
        },
