        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "five_keepers_paid"
                        }
                    ],
                    Priority: 36,
                    Buttons: [
                        {
                            Name: "Ask about the five keepers",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "keepers_lore"
                                }
                            ],
                            Label: "keepers_button"
                        },
                        {
                            Name: "I will be worthy",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The five crystals answer to one hand, and the hand has been paid its due. There is nothing left for the shrines to give you but their company. That has always been the better half of the gift."
                        },
                        {
                            Text: "When the crystals sing to each other now, they sing through you. Terran says it feels like weather changing. Ignis says it feels like an argument ending. They are both right."
                        }
                    ],
                    Name: "Aurora - five keepers answered",
                    Label: "five_paid"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "fairy_crystal_claimed"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "ground_crystal_claimed"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "dragon_crystal_claimed"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "ice_crystal_claimed"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "fire_crystal_claimed"
                        }
                    ],
                    Priority: 35,
                    Buttons: [
                        {
                            Name: "I carry all five",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/shrine/five_keepers_reward"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_five_keepers_paid"
                                }
                            ],
                            Label: "claim_button"
                        },
                        {
                            Name: "Ask about the five keepers",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "keepers_lore"
                                }
                            ],
                            Label: "keepers_button"
                        },
                        {
                            Name: "Not yet",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Five keepers. Terran, Draconis, Glacius, Ignis - and I. All of us leaned toward you, and all of us let you pass. That has not happened in the whole long memory of the water."
                        },
                        {
                            Text: "The crystals answer to one hand now. Yours. I do not know whose hand it was before, but the shrines do, and they are not afraid of it. Come to me, and the five keepers will answer together."
                        }
                    ],
                    Name: "Aurora - all five",
                    Label: "all_five"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "fairy_shrine_trial_clear"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_fairy_crystal_claimed"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Receive the Fairy Shrine Crystal",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "give @s cobblemon-initiative:fairy_shrine_crystal"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add fairy_crystal_claimed"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "claim_button"
                        },
                        {
                            Name: "Not yet",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The light parted for a proven bond, and it leaves a keepsake: its own radiance, crystallized. Set it anywhere under open sky and the light will take a shape you can catch - if the two of you are quick enough to deserve it."
                        }
                    ],
                    Name: "Aurora - the crystal",
                    Label: "cleared"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_fairy_shrine_leader"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Thank you, Priestess",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The radiance walks beside you now. It will light corners of you that you would rather keep dark. That is its kindness, and its cruelty."
                        },
                        {
                            Text: "When I looked through the light at you, I did not see a beginning. I saw a long, long shadow already cast. Carry it gently."
                        }
                    ],
                    Name: "Aurora - after defeat",
                    Label: "after"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Take in the shrine",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cutscene play fairy_shrine_reveal"
                                }
                            ],
                            Label: "gaze_button"
                        },
                        {
                            Name: "Step into the light",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_fairy_shrine_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "say The light already named you. It does not name a soul twice."
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_fairy_shrine_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs attach rctmod:fairy_shrine_leader @s"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_fairy_shrine_leader"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs battle GEN_9_SINGLES @s vs rctmod:fairy_shrine_leader onwin {1: ['cobbledollars give @1 2500', 'tag @1 add defeated_fairy_shrine_leader', '@2 say The light has chosen to follow you. Be gentle with what it shows you.', 'execute as @1 unless entity @1[tag=shrine_frag_seen] run function cobblemon_initiative:memory/shrine/first_keeper'], 2: ['@1 say The radiance turns away for now. Come back when your heart is steadier.']}"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "fairy_resolve_ready"
                                }
                            ],
                            Label: "yes_button"
                        },
                        {
                            Name: "Step into the light",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The light holds you at its edge. Aurora does not move. The vows are not yet kept - climb back up the drowned stair and take them in order, from the First Vow at the top of the water. The fifth vow, resolve, opens the way.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_fairy_resolve_ready"
                                }
                            ],
                            Label: "not_ready_button"
                        },
                        {
                            Name: "Not yet",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Soft now. You have reached the floor of the drowned stair, where the light does not warm so much as it reveals. I am Aurora, its keeper and its servant. The choir you passed on the way down was mine once. Now I am theirs."
                        },
                        {
                            Text: "The radiance does not test a team. It tests a bond. Five vows line the stair above you - devotion, nourishment, a name, the light, and at the last, resolve. Take each vow at its keeper as you descend, with one bonded companion who will stand alone on your belt."
                        },
                        {
                            Text: "I cannot give you the light. I can only stand between you and it until every vow is kept. Keep the fifth, and step into the light."
                        }
                    ],
                    Name: "Aurora - the floor",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Walk on",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Terran fights in the dark under Kalahar with his strength halved, so the stones may judge fairly. He halves his suppers too. I asked him why once. He pointed at the floor."
                        },
                        {
                            Text: "Draconis tends the wyrm-fire near the keep. He speaks to the hydra like an old colleague he does not entirely trust. The hydra, I am told, speaks back the same way."
                        },
                        {
                            Text: "Glacius stands past Nifl and has not raised his voice in living memory. He says the cold carries it for him. I have heard his whisper from clean across the ice, and I believe him."
                        },
                        {
                            Text: "Ignis argues with his flame like a married man. The flame sputters back. Of the two of them, the fire apologises first. You will find him out beyond the last flame."
                        },
                        {
                            Text: "And I keep the light in the marsh deep, at the floor of a drowned stair, with a choir that remembers being human. Of the five of us, I am told I do the turning-away most kindly. I practise."
                        }
                    ],
                    Name: "Aurora - the keepers",
                    Label: "keepers_lore"
                }
            ]
        },
