        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_7_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "Keep the fire lit",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Feel that? The wind off the spine still bites, but it is my wind now, over my furrows, not a yield line on somebody's clipboard. My people cut these rows into the cold long before the Company decided frost was an asset."
                        },
                        {
                            Text: "The transition orders went into the silo stove, where they finally did some good. Rest at my fence when the spine wind turns - travelers eat warm here now, and so do their teams."
                        }
                    ],
                    Name: "Bran - the furrows thaw",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_7"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_7_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - break the rail",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_7}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"COLDFURROW LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Bran shoulders the frozen fence rail off its posts - Coldfurrow runs free, and the highest field on the spine feeds the road instead of the tower.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The Manager walked off the silo steps with her clipboard tucked under her arm and no crew behind her. That means the paper is dead and only the fence is left - and a fence is just frozen rail once nobody official is holding it up. Say the word and I break it."
                        }
                    ],
                    Name: "Bran - the fence is next",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the silo",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "This was a hill farm before it was an asset. Furrows cut into the frost, a stove in the silo, and nobody counting who crossed the fence. Then the Company ran their wire up the spine and started calling my harvest a yield the cold owed them."
                        },
                        {
                            Text: "Two of them hold the parcel. The officer down the fence line will stop you at the wire and call it a conversation. Rei runs the whole string from the silo and has never once looked up from her clipboard - not even when the wind takes the paper."
                        },
                        {
                            Text: "I do not want a war. I want my furrows back, my stove lit, and travelers who stop because the fence has a fire behind it. Deal with the clipboards and I will handle the frozen rail myself."
                        }
                    ],
                    Name: "Bran",
                    Label: "default"
                }
            ]
        },
