#!/usr/bin/env python3
"""generate_npc_overlay — bake the NPC layer data for the zone-mapper.

Sources, layered:
  - builders' CSV (dev/)              — uuid-bodied NPCs + their coords (weeks stale)
  - npc_presets.json                  — which uuid bodies are wired to a quest preset
  - dialog-src/characters/**/*.json   — LIVE latch-placed cast (placement, no uuid),
                                        the hundreds added since the CSV export
  - the PLANNED list below            — new bodies not yet in the world

Writes dev/zone-map/npc-overlay.js (or $ZONE_MAP_OUT/npc-overlay.js), loaded by
zone-editor.html to render every NPC on the uNmINeD map: green = wired/authored,
gray = builder flavor (no role), orange = planned placement (no body yet).

CAVEAT: uuid-body coords come from the stale CSV, so a body moved by a later
repairs_a*_apply tp shows at its OLD spot (scripts/npc_roster applies those
overrides — mirror them here if live body positions ever matter for zoning).

Rerun after casting changes:  python3 scripts/generate_npc_overlay
"""

import csv
import glob
import json
import os

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CHARS_DIR = os.path.join(ROOT, "dialog-src", "characters")
CSV_PATH = os.path.join(ROOT, "dev", "UPM 2_ Full NPC List - npc_list.csv.csv")
PRESETS = os.path.join(ROOT, "npc_presets.json")
# Default serve dir is dev/zone-map; the zone-mapper launcher passes ZONE_MAP_OUT so the
# overlay lands in whatever render dir it is serving (honours `zone-mapper -o <dir>`).
OUT = os.path.join(
    os.environ.get("ZONE_MAP_OUT", os.path.join(ROOT, "dev", "zone-map")),
    "npc-overlay.js",
)

# New bodies that still need placing — coords verified inside their zone corridors
# (see docs/PLACEMENT_TOWNS_1-2.md). Move entries up into the CSV once placed.
# alpha.26 audit rulings: the ghost cast (sq_kyc_agent, notice_post_1..3,
# company_surveyor, villain_grunt_field_agent, villain_grunt_2) was CUT — removed here.
PLANNED = [
    ("agent_yield_lead",      "roof grunt (mayor scene)",      2015, 169, 2466),
    ("agent_yield_second",    "roof grunt (mayor scene)",      2015, 169, 2463),
    ("sango_company_liaison", "Company rep at the wheat field", 2581, 111, 2822),
    ("courier_mio",           "Sprint start line",             2486, 100, 2914),
    ("forewoman_tetsu",       "Work Orders waystation",        2319, 100, 2899),
    ("apiarist_sumi",         "apiary + wild hives",           2290, 100, 2894),
    ("field_researcher_ume",  "Head Count table",              2192, 100, 2835),
]


def latch_characters():
    """Latch-placed dialog-src characters (a `placement`, no uuid) at their authored coords.

    The builders' CSV only covers uuid-bodied NPCs and is weeks stale, so the ~hundreds of
    latch-placed cast added by later playtest waves are invisible without this. Reads the LIVE
    source of truth (dialog-src/characters/**/*.json). uuid-bodied chars are skipped here — they
    come from the CSV. Summon-only bodies (no uuid AND no placement, e.g. the revived_* fossil
    gifts) exist nowhere fixed, so they're skipped too.
    """
    out = []
    for path in sorted(glob.glob(os.path.join(CHARS_DIR, "**", "*.json"), recursive=True)):
        try:
            ch = json.load(open(path, encoding="utf-8"))
        except Exception:
            continue
        if ch.get("kind") != "character":
            continue
        if (ch.get("uuid") or "").strip():
            continue                                    # uuid body → already in the CSV
        pl = ch.get("placement")
        if not isinstance(pl, dict) or "x" not in pl:
            continue                                    # summon-only / no fixed spot
        area = os.path.basename(os.path.dirname(path))
        out.append({
            "name": ch.get("display_name") or ch.get("id"),
            "town": area, "kind": ch.get("role") or "npc",
            "x": float(pl["x"]), "y": float(pl.get("y", 0)), "z": float(pl["z"]),
            "uuid": None, "preset": ch.get("id"),
            "role": ch.get("role") or "latch NPC",
            "status": "wired",                          # authored, latch-placed cast
        })
    return out


def main():
    mappings = json.load(open(PRESETS))["mappings"]
    by_uuid = {u: v for u, v in mappings.items() if not u.startswith("_")}

    npcs = []
    with open(CSV_PATH, encoding="utf-8-sig") as fh:
        for r in csv.DictReader(fh):
            u = r["UUID"].strip()
            m = by_uuid.get(u)
            npcs.append({
                "name": r["Name"], "town": r["Town"], "kind": r["Type"],
                "x": int(r["X"]), "y": int(r["Y"]), "z": int(r["Z"]),
                "uuid": u,
                "preset": (m or {}).get("preset"),
                "role": (m or {}).get("label"),
                "status": "wired" if m else "flavor",
            })
    # Layer the live latch-placed cast on top of the (stale, uuid-only) CSV.
    npcs.extend(latch_characters())
    for pid, note, x, y, z in PLANNED:
        npcs.append({"name": pid, "town": "(planned)", "kind": "PLANNED",
                     "x": x, "y": y, "z": z, "uuid": None,
                     "preset": pid, "role": note, "status": "planned"})

    counts = {}
    for n in npcs:
        counts[n["status"]] = counts.get(n["status"], 0) + 1
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as fh:
        fh.write("// generated by scripts/generate_npc_overlay — do not edit by hand\n")
        fh.write("window.NPC_OVERLAY = ")
        json.dump({"counts": counts, "npcs": npcs}, fh, ensure_ascii=False)
        fh.write(";\n")
    print(f"wrote {os.path.relpath(OUT, ROOT)}: "
          + ", ".join(f"{k}={v}" for k, v in sorted(counts.items())))


if __name__ == "__main__":
    main()
