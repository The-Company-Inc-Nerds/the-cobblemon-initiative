        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Offer rotten flesh — 8 pieces",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/morveth/feed"
                                }
                            ],
                            Label: "feed_button"
                        },
                        {
                            Name: "Leave the keeper to his post",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The bog-keeper you may have heard of is not here. He is here. We have been — rearranged. The boy at the foot of the rise had a book, the witch of the house had a vacancy, and the marsh never wastes a good listener."
                        },
                        {
                            Text: "This bog has drunk empires. I used to say that with my own mouth, over tea, to travellers who nodded politely. It is truer from the inside. Everything is."
                        },
                        {
                            Text: "The witch does not receive visitors. She receives reports. You are in one now. Stand however you would like to be described."
                        },
                        {
                            Text: "The boy sends travellers up with rotten flesh when he can persuade them. The witch counts it as rent. I count it as kindness. The marsh counts everything, and the marsh is never wrong by so much as a bone."
                        }
                    ],
                    Name: "Morveth — keeper of the rise",
                    Label: "default"
                }
            ]
        },
