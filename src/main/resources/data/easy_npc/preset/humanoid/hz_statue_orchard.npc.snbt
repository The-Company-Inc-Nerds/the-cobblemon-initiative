        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "seal_orchard"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Study the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "study_button"
                        },
                        {
                            Name: "Leave the garden",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The threshold seal has set into the gatepost stone, and the ivy has turned one leaf toward it — the old botany says that is how a gate garden approves of a guest."
                        },
                        {
                            Text: "The stone warden keeps its watch on the path to the gym. Nothing gets to the keeper it does not let through."
                        }
                    ],
                    Name: "The Gate Garden — the seal holds",
                    Label: "sealed"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_hua_zhan_trainer_2"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_seal_orchard"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Press your hand to the seal",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add seal_orchard"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/pilgrimage/update"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator actionbar [{\"text\":\"The gate garden's seal takes.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "press_button"
                        },
                        {
                            Name: "Step back",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The threshold opens. You passed the gate garden the way it likes to be passed — slowly, and looking — and the stone does not open for tourists."
                        },
                        {
                            Text: "The seal is set in the gatepost. Press your hand, and the garden at the door will vouch that you came the old way."
                        }
                    ],
                    Name: "The Gate Garden — after the match",
                    Label: "seal"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "pilgrimage_started"
                        }
                    ],
                    Priority: 15,
                    Buttons: [
                        {
                            Name: "Ready a Pokéball — wake the warden of the gate garden",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "execute as @initiator run function cobblemon_initiative:hua_zhan/warden_wake {x:1451,y:90,z:2026}"
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_hua_zhan_trainer_2"
                                            }
                                        ]
                                    },
                                    Cmd: "say You already passed this threshold. The seal is set in the gatepost."
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_hua_zhan_trainer_2"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs attach rctmod:hua_zhan_trainer_2 @s"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_hua_zhan_trainer_2"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs battle GEN_9_SINGLES @s vs rctmod:hua_zhan_trainer_2 onwin {1: ['tag @1 add defeated_hua_zhan_trainer_2', '@2 say The threshold opens. You passed the gate garden the way it likes — slowly, and looking. The seal in the gatepost will take your hand now.', '@2 execute at @s run particle minecraft:totem_of_undying ~ ~1.2 ~ 0.4 0.9 0.4 0.08 120 force', '@2 execute at @s run particle minecraft:end_rod ~ ~1 ~ 0.3 0.8 0.3 0.02 60 force', '@2 execute at @s run playsound minecraft:block.beacon.activate master @a ~ ~ ~ 1 1.3', 'effect give @2 minecraft:glowing 60 0 true', 'execute as @1 run function cobblemon_initiative:hua_zhan/seal_hint'], 2: ['@1 say The gate garden does not open for the impatient. Come back to the threshold when you are ready to be weighed.']}"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_defeated_hua_zhan_trainer_2"
                                }
                            ],
                            Label: "battle_button"
                        },
                        {
                            Name: "Read the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "plaque_button"
                        },
                        {
                            Name: "Leave the garden",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "WARDEN OF THE GATE GARDEN — the threshold. The old botany carved this one at the very door of the gym, because the garden decides who reaches the keeper long before the keeper does. It is the last green you pass and the first that judges you."
                        },
                        {
                            Text: "Master Wei sent you, so the gate will answer. Wake the guardian of the threshold and best it — a garden lets through what it has weighed, and it means to weigh you. When it yields, touch the stone once more: the seal at the gatepost is pressed after the match."
                        }
                    ],
                    Name: "The Gate Garden — the stone stirs",
                    Label: "challenge"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Read the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "plaque_button"
                        },
                        {
                            Name: "Leave the garden",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "WARDEN OF THE GATE GARDEN — second of the four stone wardens, standing in the little garden at the gym's threshold. A carving on the gatepost reads: the door is the garden's, not the keeper's."
                        },
                        {
                            Text: "The stone keeps its watch on the path and does not stir for passers-by. They say Garden Master Wei, up the west hill, knows how to wake it."
                        }
                    ],
                    Name: "Warden of the Gate Garden",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Back to the warden",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        },
                        {
                            Name: "Done reading",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "OLD BOTANY, PAGE OF THE GATE GARDEN. The first gardeners planted the threshold last and trusted it first. A garden at a door is a slow kind of guard — it lets everyone in and remembers everyone who hurried."
                        },
                        {
                            Text: "The keeper of a gym is only the last test. The garden at the gate is the first, and the honest one: it asks nothing but that you walk in looking, and it has turned away more of the proud than any leader ever has."
                        }
                    ],
                    Name: "Old Botany — The Threshold",
                    Label: "lore"
                }
            ]
        },
