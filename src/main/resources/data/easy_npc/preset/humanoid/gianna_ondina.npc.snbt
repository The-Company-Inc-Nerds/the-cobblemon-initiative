        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "sq_trident_race_done"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Thank you, Tide-Caller",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You rode the rings clean, and the sea kept its word — that trident is yours now. It does not call the same run twice, child. Once is how the tide gives things back."
                        },
                        {
                            Text: "I watched you keep the tide's pace. Rarer than a full purse, that. The rings are under now; the sea only leaves them for someone it has not yet measured, and it has measured you."
                        }
                    ],
                    Name: "Tide-Caller Gianna — you rode it clean",
                    Label: "done"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Take the trident - run the tide-rings",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/trident_race/start {ticks:1200}"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "race_button"
                        },
                        {
                            Name: "Not today",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "I read the tide for this harbour, child, and lately it leaves a run of fifteen rings out past the shallows — ring to ring, before the water pulls them under. Take my old trident and ride them. You do not need a badge for the sea; you only need to keep its pace."
                        },
                        {
                            Text: "The Company hangs its banners and calls the sea a resource. The sea has not been told. Ride the rings if you like — but ride them clean the first time, for the tide does not call the same run twice."
                        },
                        {
                            Text: "Riptide only fires in the water, so stay under the surface and let the trident throw you ring to ring. Miss the clock and the sea takes its trident back; ride it clean and it is yours to keep."
                        }
                    ],
                    Name: "Tide-Caller Gianna — the harbour woman",
                    Label: "default"
                }
            ]
        },
