        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Ask about the wool",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Upstairs. Shu keeps the shelf now — white by the bale, black by the bundle, and the spare shears. Tell her the stairs sent you. She will log that.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "upstairs_button"
                        },
                        {
                            Name: "Ask about the flock",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"One Wooloo. Cloud, at the mill — Guo shears him, Shu cards and bales it now. The last independent wool in Hua Zhan, and the softest monopoly you will ever meet.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "flock_button"
                        },
                        {
                            Name: "Leave the counter",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Kaito Zhang. This counter sold wool for thirty years — my arithmetic, my shears, one very committed Wooloo up at the mill. These days the arithmetic lives upstairs with my granddaughter Shu, and the counter and I mostly hold each other up."
                        },
                        {
                            Text: "I minded a register once, with a verified sign over it. I sold the arithmetic, kept the shears, then handed the shears on too. You get one retirement, and I am spending mine at exactly this speed."
                        },
                        {
                            Text: "If you are here for wool, take the stairs. She weighs twice, she rounds in your favour on rainy days, and she has never once misfiled a fleece. I audited her for a year before admitting I was only doing it for the company."
                        }
                    ],
                    Name: "Kaito Zhang — the house counter",
                    Label: "default"
                }
            ]
        },
