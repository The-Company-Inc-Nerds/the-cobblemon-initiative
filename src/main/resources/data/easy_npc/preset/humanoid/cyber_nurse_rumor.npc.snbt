        DialogData: {
            Type: "CUSTOM",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Rest my team",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add met_cyber_nurse"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "healpokemon @initiator"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "heal_button"
                        },
                        {
                            Name: "Use the PC",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:pc/open"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "pc_button"
                        },
                        {
                            Name: "What is the word downtown?",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add met_cyber_nurse"
                                },
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "rumors"
                                }
                            ],
                            Label: "rumor_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Welcome to Cyber City Center. I will patch your team up - the road in is rough and the town is rougher lately."
                        },
                        {
                            Text: "Half my regulars come in just to sit where the lights do not flicker. Nobody at the Company will say why the boards outside keep glitching."
                        },
                        {
                            Text: "Have we met? No. No, I would remember. ...Hm. That came out as a joke about my field, and I did not intend it, which is itself rather a joke about my field."
                        },
                        {
                            Text: "Memory is just a signal that keeps re-firing until you believe it. Interesting failure mode: a signal so thoroughly deleted that only the empty socket remains, itching. Purely theoretical, of course. Now - your team?"
                        }
                    ],
                    Name: "Dr. Orion Synapse",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "The tower on the north plaza",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Dr. Orion Synapse: Ohmond works the stall by the seam and reads the field ledgers for sport. If you mean to walk into that tower, he can tell you the number that opens the door.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "defeated_cyber_leader"
                                },
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_hq_pointer_done"
                                }
                            ],
                            Label: "tip_hq"
                        },
                        {
                            Name: "Back",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        },
                        {
                            Name: "Thanks",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The grey suits are packing the tower down on the north plaza, not trading. Something is ending over there, and it is not the workday."
                        },
                        {
                            Text: "First good number I have seen in a season came in with you - the exchange board twitched down half a point. Somebody has been liberating fields. Keep it up and maybe the coin stops lying."
                        }
                    ],
                    Name: "Dr. Orion Synapse - the word downtown",
                    Label: "rumors"
                }
            ]
        },
