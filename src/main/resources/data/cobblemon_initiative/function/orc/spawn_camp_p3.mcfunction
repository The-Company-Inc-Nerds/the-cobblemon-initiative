# Orc camp P3 (1467 167 3554) — eastern pass war-camp, hard tier (major spoils on clear).
# Run positioned at the pin from orc/tick; latch set FIRST (one-shot raise). 6 mobs:
# three axe vindicators in chain-and-iron, two husk marauders, War-Chief in full iron at
# 56 HP. Same drop-chance loot carry as P2 (0.25f armor / 0.5f hands, husks CanPickUpLoot 0b).
scoreboard players set #orc_camp_p3 ci_ambient 1
title @a[distance=..48] actionbar [{"text":"War-drums on the ridge — a raider camp stirs","color":"red"}]
execute positioned ~4 ~1 ~-3 run summon minecraft:vindicator ~ ~ ~ {Tags:["orc_camp_p3","ci_orc"],PersistenceRequired:1b,CustomName:'{"text":"Orc Raider"}',HandItems:[{id:"minecraft:iron_axe",count:1},{}],HandDropChances:[0.5f,0.0f],ArmorItems:[{},{},{id:"minecraft:chainmail_chestplate",count:1},{id:"minecraft:iron_helmet",count:1}],ArmorDropChances:[0.25f,0.25f,0.25f,0.25f]}
