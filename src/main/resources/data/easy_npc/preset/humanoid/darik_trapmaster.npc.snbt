        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_safari_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Find the ranger",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Gate is shut, friend. Not by me. The clipboard people annexed the whole Preserve - specimen acquisition site, they call it now - and I hold this counter and say the words they wrote for me. There is a ranger by the east fence, Nova Circuit, who is still saying her own. Talk to her."
                        },
                        {
                            Text: "Do not ask me to open the gate. Asking me gets both of us transitioned, and I have a family. The ranger at the east fence is past caring about that - Nova Circuit. Whatever she is planning, it is more than I have managed."
                        },
                        {
                            Text: "I used to run the intake here. Live traps, gentle hands, everything back where it belongs by dusk. Now I count crates for people who count creatures. If you want that to change, the ranger Nova Circuit by the east fence is where change is standing."
                        }
                    ],
                    Name: "Darik Trapmaster - under new management",
                    Label: "locked"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Start a Capture Round",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative safari enter capture"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "capture_button"
                        },
                        {
                            Name: "Start a Contest Round",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative safari enter contest"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "contest_button"
                        },
                        {
                            Name: "Buy Executive Blend bait",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative safari bait executive_blend 2"
                                }
                            ],
                            Label: "bait_button"
                        },
                        {
                            Name: "How did my round go?",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative safari status"
                                }
                            ],
                            Label: "status_button"
                        },
                        {
                            Name: "Just looking",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Intake is open, and the snares are staying in the shed. My trapping days taught me the one thing worth knowing: a creature comes quietest when it chooses to. That is the whole Preserve idea. In you go."
                        },
                        {
                            Text: "House rules at this counter: your kit and your team wait in custody with me, and you walk in with what the Preserve issues - Preserve Balls, bait, snowballs. Everything comes back out when your round ends, plus whatever chose to stay with you."
                        },
                        {
                            Text: "Capture round, you keep what you catch. Contest round, the judges score your best find and it goes home to the grass after appraisal. That last part is the rule Helga wrote, and it is the best rule we have."
                        },
                        {
                            Text: "Entry is the posted rate at the counter, same for everyone - Helga does not do favorites, only birthdays. The Executive Blend bait runs extra, posted rate again, and the rare ones cannot leave it alone. I have stopped asking what is in it."
                        }
                    ],
                    Name: "Darik Trapmaster - the intake counter",
                    Label: "default"
                }
            ]
        },
