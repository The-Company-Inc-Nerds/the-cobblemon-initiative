        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_2_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "The marsh remembers",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The water runs where it likes again and the rice stands up straighter every dawn. You gave an old steward his field back. The marsh will not forget it, and neither will I."
                        },
                        {
                            Text: "Marsh-rice for the town again, not for a ledger. If the Company sends another fence, they will find the whole fen against them this time. Mind Quarry Road south — the stone is Company ground too."
                        }
                    ],
                    Name: "Steward Halvard - the water runs",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_2"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_2_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - open the sluice",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_2}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"MIREBLOOM LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the paddies are off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Halvard hauls the sluice gate wide — the Mirebloom Paddies run free, and the marsh takes its field back.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_sluice_button"
                        },
                        {
                            Name: "Hold the water a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "You moved that enforcer off my gate. I watched the whole bout from the dyke and I have not breathed this easy in a season. Say the word and I open the sluice — the marsh takes its field back the moment the water runs."
                        }
                    ],
                    Name: "Steward Halvard - say the word",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the fence",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Keep your voice down, pilgrim. That is a Company enforcer on my fence gate. The Mirebloom Paddies fed this town for three generations, and now I sign a receipt to walk my own dykes."
                        },
                        {
                            Text: "I steward these paddies — stewarded, before the fence went up. The Company calls it verification. The rice calls it drowning on a schedule. And I can do nothing while that man holds the gate."
                        },
                        {
                            Text: "They fenced the water first, then the field, then me. If somebody were to move that enforcer off my gate, the sluice could run inside the hour. I did not say that out loud."
                        },
                        {
                            Text: "Strange thing — the enforcer squints at you like a memo he was told to shred. I stopped asking what the Company forgets on purpose. It is safer not to know."
                        }
                    ],
                    Name: "Steward Halvard",
                    Label: "default"
                }
            ]
        },
