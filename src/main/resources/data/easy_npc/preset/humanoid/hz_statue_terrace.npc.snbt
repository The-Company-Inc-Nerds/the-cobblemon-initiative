        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "seal_terrace"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Study the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "study_button"
                        },
                        {
                            Name: "Leave the square",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The seal is set in the knight's plinth, and the square's dust does not settle on it. Iron keeps its own the way stone keeps a promise."
                        },
                        {
                            Text: "The knight stands straight again over the square, blank visor to the street. For a heartbeat, as you turn away, the polished stone holds a face — and then it is just stone."
                        }
                    ],
                    Name: "The Stone Knight — the seal holds",
                    Label: "sealed"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_hua_zhan_trainer_3"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_seal_terrace"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Press your hand to the seal",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add seal_terrace"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/pilgrimage/update"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator actionbar [{\"text\":\"The stone knight's seal takes.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "press_button"
                        },
                        {
                            Name: "Step back",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The knight yields — as far as iron yields. You stood straight against it, and a straight back is the one thing this stone respects."
                        },
                        {
                            Text: "The seal is set in the plinth. Press your hand — and pay no mind to the face the visor held for a heartbeat. The old botany says the stone only shows what was already yours."
                        }
                    ],
                    Name: "The Stone Knight — after the match",
                    Label: "seal"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "pilgrimage_started"
                        }
                    ],
                    Priority: 15,
                    Buttons: [
                        {
                            Name: "Ready a Pokéball — wake the stone knight",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "execute as @initiator run function cobblemon_initiative:hua_zhan/warden_wake {x:1479,y:87,z:2112}"
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_hua_zhan_trainer_3"
                                            }
                                        ]
                                    },
                                    Cmd: "say The knight has already saluted you. Its seal is set in the plinth."
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_hua_zhan_trainer_3"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs attach rctmod:hua_zhan_trainer_3 @s"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_hua_zhan_trainer_3"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs battle GEN_9_SINGLES @s vs rctmod:hua_zhan_trainer_3 onwin {1: ['tag @1 add defeated_hua_zhan_trainer_3', '@2 say The knight yields — as far as iron yields. You stood straight, and it respects a straight back. The seal in the plinth will take your hand.', '@2 execute at @s run particle minecraft:totem_of_undying ~ ~1.2 ~ 0.4 0.9 0.4 0.08 120 force', '@2 execute at @s run particle minecraft:end_rod ~ ~1 ~ 0.3 0.8 0.3 0.02 60 force', '@2 execute at @s run playsound minecraft:block.beacon.activate master @a ~ ~ ~ 1 1.3', 'effect give @2 minecraft:glowing 60 0 true', 'execute as @1 run function cobblemon_initiative:hua_zhan/seal_hint'], 2: ['@1 say The knight has held this square longer than the badge has existed. It is not moved by a hurried hand. Stand straighter and return.']}"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_defeated_hua_zhan_trainer_3"
                                }
                            ],
                            Label: "battle_button"
                        },
                        {
                            Name: "Read the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "plaque_button"
                        },
                        {
                            Name: "Leave the square",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "THE STONE KNIGHT — the iron of the four. The old botany carved this one wrong on purpose: not a gardener but a guard, straight-backed in the square, because even a garden keeps one that will not bend. It has held this stone longer than the badge has existed."
                        },
                        {
                            Text: "Strange — the light caught its blank visor when you walked up, and for a heartbeat the polished stone held a face this knight almost knew. Master Wei sent you, so the iron will answer. Wake it, and stand straight. When the knight yields, lay your hand on the stone again — the seal in the plinth is pressed after the match."
                        }
                    ],
                    Name: "The Stone Knight — the stone stirs",
                    Label: "challenge"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Read the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "plaque_button"
                        },
                        {
                            Name: "Leave the square",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "THE STONE KNIGHT — third of the four stone wardens, and the odd one: a guard in armour where the others are gardeners, straight-backed in the middle of the square. A line on the plinth reads: even a garden keeps one that stands with a straight back."
                        },
                        {
                            Text: "The visor is blank and polished, and the stone does not stir for passers-by. They say Garden Master Wei, up the west hill, knows how to wake it."
                        }
                    ],
                    Name: "The Stone Knight",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Back to the warden",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        },
                        {
                            Name: "Done reading",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "OLD BOTANY, PAGE OF THE STONE KNIGHT. The first gardeners carved three wardens of soft things and one of iron, and never explained the fourth. A garden that cannot defend itself is only a field waiting to be re-zoned. The knight is the botany that learned to stand."
                        },
                        {
                            Text: "There is a page here the old botany never finished. The knight's visor is polished to a mirror, and some mornings it shows a face a heartbeat before its owner arrives. Whatever the stone shows you, the page says, it was already yours."
                        }
                    ],
                    Name: "Old Botany — The Iron",
                    Label: "lore"
                }
            ]
        },
