            {}
        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_8_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "Keep the gate warm",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Listen - the silo is quiet. No ledger clerk counting frost, no memo pinned to the ice. My grandmother learned to farm a field that keeps, banking grain under the snow so the town ate through the long white months. She did not do it for a tower window."
                        },
                        {
                            Text: "The Company paper is frozen into the silo wall now, which is exactly where paper like that belongs. Warm yourself at my gate when the pass turns - travelers eat here now, and so do their teams."
                        }
                    ],
                    Name: "Sena - the thaw comes",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_8"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_8_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - clear the rail",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_8}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"FROSTFALLOW LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Sena kicks the iced fence rail loose from its posts - Frostfallow runs free, and the field that keeps stores grain for the pass again instead of the tower.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The Manager came down off the silo with frost on her clipboard and nothing behind her but the wind. That means the paper is dead and only the fence is left - and a fence is just iced rail once nobody official is holding it up. Say the word and I clear it."
                        }
                    ],
                    Name: "Sena - the fence is next",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the silo",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "This was a keeping-farm before it was an asset - a field the frost preserves and a silo that banks grain under the snow. Nobody counted who crossed the pass. Then the Company iced the gate shut and started calling my stored harvest a yield that never spoils on their schedule."
                        },
                        {
                            Text: "Two of them hold the parcel. The officer at the wire will stop you and call it a conversation. The Manager runs the whole frozen string from the silo and has never once looked up from her clipboard, even with the ice on it."
                        },
                        {
                            Text: "I do not want a war. I want my silo back, my gate thawed, and a pass that stops here because the grain is good. Deal with the clipboards and I will handle the iced rail myself."
                        }
                    ],
                    Name: "Sena",
                    Label: "default"
                }
            ]
        },
