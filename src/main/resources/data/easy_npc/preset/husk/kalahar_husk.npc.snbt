        entityTypeId: "easy_npc:husk",
        modified: 0L,
        name: "The Sun-Dried Sentinel",
        variantType: "HUSK",
        version: "1.0.0"
    },
    data: {
        ActionData: {
            ActionEventSet: {
                ON_INTERACTION: [
                    {
                        Type: "OPEN_DEFAULT_DIALOG"
                    }
                ]
            }
        },
        ArmorDropChances: [0.085f, 0.085f, 0.085f, 0.085f],
        ArmorItems: [
            {},
            {},
            {},
            {}
        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "husk_quiz_done"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Rest a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The wind has taken my riddles, walker. What was yours to win is won, or is lost to the sand. Either way I have no more questions for a face I half remember."
                        },
                        {
                            Text: "Sit if you like. The dune keeps good company for those who do not mind silence, and I have had nothing but silence for a very long time."
                        }
                    ],
                    Name: "The Sun-Dried Sentinel",
                    Label: "done"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Ask your three questions",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "q1"
                                }
                            ],
                            Label: "quiz_button"
                        },
                        {
                            Name: "Not now",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Sit, walker. I do not rise anymore — the sun dried me to the dune and I have made my peace with the view. But I still keep a thing worth having, for the one who can answer for it."
                        },
                        {
                            Text: "Wings. Real ones, and the fire to drive them. The desert flew, once, before it was only sand. I will pass that flight to a sharp mind and no other. Three questions. Answer them true and the sky is yours."
                        },
                        {
                            Text: "You have the look of someone the Company would rather forget. Good. So do I. Answer my riddles and we will both be remembered for something better than a ledger."
                        }
                    ],
                    Name: "The Sun-Dried Sentinel",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "A Drowned",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "q2"
                                }
                            ],
                            Label: "a_drowned"
                        },
                        {
                            Name: "A Skeleton",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sentinel sighs, and the sand runs out of the sigh. Wrong, walker. The sky stays with me.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_skeleton"
                        },
                        {
                            Name: "A Bogged",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sentinel sighs, and the sand runs out of the sigh. Wrong, walker. The sky stays with me.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_bogged"
                        }
                    ],
                    Texts: [
                        {
                            Text: "First. I am a husk — a walking dead the desert dried out before the water could reach it. Sink one of my green cousins beneath deep water long enough and it does not drown. It CHANGES. Into what?"
                        }
                    ],
                    Name: "The Sentinel - first question",
                    Label: "q1"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Ground",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "q3"
                                }
                            ],
                            Label: "a_ground"
                        },
                        {
                            Name: "Water",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sentinel shakes his wrapped head. No. The storm loves the water. The sky stays with me.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_water"
                        },
                        {
                            Name: "Steel",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sentinel shakes his wrapped head. No. Steel still feels the spark. The sky stays with me.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_steel"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Good. Second. The sand hides my kin and theirs — the ones that burrow. There is one type of Pokemon that a storm cannot touch: an Electric attack does NOTHING to it, no damage at all. WHICH type?"
                        }
                    ],
                    Name: "The Sentinel - second question",
                    Label: "q2"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Gunpowder",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_gift_husk_quiz_wings_claimed"
                                            }
                                        ]
                                    },
                                    Cmd: "loot give @s loot cobblemon_initiative:npc_gift/husk_wings"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_gift_husk_quiz_wings_claimed"
                                            }
                                        ]
                                    },
                                    Cmd: "tag @s add gift_husk_quiz_wings_claimed"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sun-Dried Sentinel presses dry wings into your hands. Fly, walker - the desert flew once, and now it flies through you.\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_gunpowder"
                        },
                        {
                            Name: "Blaze Powder",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sentinel closes his eyes. So close to the fire, and yet. The sky stays with me, walker.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_blaze"
                        },
                        {
                            Name: "Redstone Dust",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add husk_quiz_done"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"The Sentinel closes his eyes. No. That dust hums, it does not thunder. The sky stays with me.\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "a_redstone"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Last, walker. My gift is wings, and the rockets that drive them. A firework rocket is folded from paper and ONE other thing — the black dust that makes the desert's thunder. NAME it, and fly."
                        }
                    ],
                    Name: "The Sentinel - last question",
                    Label: "q3"
                }
            ]
        },
