        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "seal_pond"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Study the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "study_button"
                        },
                        {
                            Name: "Leave the rows",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The seal sits low among the rows, half-hidden by leaves, the way everything here is half-hidden. The quiet garden does not advertise, and it does not forget."
                        },
                        {
                            Text: "The stone warden keeps its watch over the little plot no one photographs. A still garden is the oldest judge in town, and the hardest to fool."
                        }
                    ],
                    Name: "The Quiet Garden — the seal holds",
                    Label: "sealed"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_hua_zhan_trainer_4"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_seal_pond"
                        }
                    ],
                    Priority: 20,
                    Buttons: [
                        {
                            Name: "Press your hand to the seal",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add seal_pond"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/pilgrimage/update"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator actionbar [{\"text\":\"The quiet garden's seal takes.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "press_button"
                        },
                        {
                            Name: "Step back",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The quiet garden is satisfied — and the quietest judge is the hardest to fool."
                        },
                        {
                            Text: "The seal is set low in the rows. Press your hand, and the honest crop will remember an honest hand."
                        }
                    ],
                    Name: "The Quiet Garden — after the match",
                    Label: "seal"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "pilgrimage_started"
                        }
                    ],
                    Priority: 15,
                    Buttons: [
                        {
                            Name: "Ready a Pokéball — wake the warden of the quiet garden",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    Cmd: "execute as @initiator run function cobblemon_initiative:hua_zhan/warden_wake {x:1538,y:84,z:2026}"
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "defeated_hua_zhan_trainer_4"
                                            }
                                        ]
                                    },
                                    Cmd: "say The quiet garden already counts you. Its seal is set low among the rows."
                                },
                                {
                                    Type: "COMMAND",
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_hua_zhan_trainer_4"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs attach rctmod:hua_zhan_trainer_4 @s"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    ConditionDataSet: {
                                        ConditionDataSet: [
                                            {
                                                Type: "PLAYER_TAG",
                                                Operation: "EQUALS",
                                                Name: "no_defeated_hua_zhan_trainer_4"
                                            }
                                        ]
                                    },
                                    Cmd: "tbcs battle GEN_9_SINGLES @s vs rctmod:hua_zhan_trainer_4 onwin {1: ['tag @1 add defeated_hua_zhan_trainer_4', '@2 say The quiet garden is satisfied — and the quietest judge is the hardest to fool. The seal in the rows will take your hand.', '@2 execute at @s run particle minecraft:totem_of_undying ~ ~1.2 ~ 0.4 0.9 0.4 0.08 120 force', '@2 execute at @s run particle minecraft:end_rod ~ ~1 ~ 0.3 0.8 0.3 0.02 60 force', '@2 execute at @s run playsound minecraft:block.beacon.activate master @a ~ ~ ~ 1 1.3', 'effect give @2 minecraft:glowing 60 0 true', 'execute as @1 run function cobblemon_initiative:hua_zhan/seal_hint'], 2: ['@1 say The quiet garden feeds people, not hurry. It will still be here, growing, when you come back grown.']}"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_defeated_hua_zhan_trainer_4"
                                }
                            ],
                            Label: "battle_button"
                        },
                        {
                            Name: "Read the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "plaque_button"
                        },
                        {
                            Name: "Leave the rows",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "WARDEN OF THE QUIET GARDEN — the humble, and the last of the four. The old botany carved this one smallest, over the plot no one looks at twice: the honest crop that feeds people instead of photographs. What a garden fears, a clever challenger brings; what a garden feeds, it never forgets."
                        },
                        {
                            Text: "Master Wei sent you, so the quiet rows will answer. Wake the guardian of the little garden and best it — the smallest judge is the one you most want on your side. When it yields, kneel to the stone once more: the seal among the rows is pressed after the match."
                        }
                    ],
                    Name: "The Quiet Garden — the stone stirs",
                    Label: "challenge"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Read the old botany",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "lore"
                                }
                            ],
                            Label: "plaque_button"
                        },
                        {
                            Name: "Leave the rows",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "WARDEN OF THE QUIET GARDEN — last of the four stone wardens, standing over a small plot most people walk straight past. A low stone reads: this row feeds people, not photographs."
                        },
                        {
                            Text: "The stone keeps its watch over the honest crop and does not stir for passers-by. They say Garden Master Wei, up the west hill, knows how to wake it."
                        }
                    ],
                    Name: "Warden of the Quiet Garden",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Back to the warden",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        },
                        {
                            Name: "Done reading",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "OLD BOTANY, PAGE OF THE QUIET GARDEN. The first gardeners ended every pilgrimage at the smallest plot on purpose. A trainer who has walked the whole circuit and still kneels to the humblest row has learned the only lesson the old botany teaches."
                        },
                        {
                            Text: "This garden grows the one coin the Company has not adjusted yet — food, honestly, for people who are hungry. It is worth nothing on any ledger and everything to the row beside it. Remember which botany taught you."
                        }
                    ],
                    Name: "Old Botany — The Quiet Row",
                    Label: "lore"
                }
            ]
        },
