                        {
                            Name: "Take the Second Vow - Nourishment",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "cobblemon-initiative shrine fairy test fullness"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
