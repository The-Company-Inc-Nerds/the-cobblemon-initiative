        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "BASIC",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Goodbye",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "goodbye_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Pen one is mine — the near one, right off Bianca's desk. She signs them in, I keep them fed and happy until you come back for them. I used to run odds on the Open; turns out minding hatchlings pays worse and worries more, and I would not trade it for the whole book."
                        },
                        {
                            Text: "No verified stamp, no Company tithe, no counting the till twice for a clerk. Just me, a bucket of feed, and a pen of small things that trust me to be there in the morning. Off the ledger, the way I like it."
                        },
                        {
                            Text: "Leave your team and go win your badge. Pen one runs tight — fed on the clock, out of the water, heads counted twice a shift. Nobody wanders off on my watch. Not anymore."
                        },
                        {
                            Text: "The old me would give you odds on which of these hatchlings evolves first. The new me just makes sure they all get the chance. Growing up is a fixed game, turns out. Best kind."
                        }
                    ],
                    Name: "Paolo Neretti",
                    Label: "default"
                }
            ]
        },
