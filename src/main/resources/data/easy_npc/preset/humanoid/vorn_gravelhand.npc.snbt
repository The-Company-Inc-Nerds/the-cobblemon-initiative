        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Browse the salvage shelf",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "salvage"
                                }
                            ],
                            Label: "salvage_button"
                        },
                        {
                            Name: "Just passing the chute",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "I clear the spoil. Whatever the pick leaves behind, I move it somewhere it is not in the way — and the good bits end up on this shelf at prices the ledger already wrote off. Salvage does not adjust. Salvage just sits there being useful."
                        },
                        {
                            Text: "Currency crisis, they say. Reserve trouble, they say. Friend, I have shovelled worse than trouble out of tighter spaces than this. It all moves eventually. Meanwhile a torch is a torch and mine cost what they cost yesterday."
                        },
                        {
                            Text: "You look like a person things happen around. Buy a spare pickaxe before they do. I hate mucking a room twice and I hate selling to a ghost even more."
                        },
                        {
                            Text: "Heard the vault is not empty at all — it is full of paperwork. Somebody upstairs worked out that forms weigh less than stars and file better. Me, I sell what falls off the cart. Nothing on my shelf has ever needed re-verifying."
                        }
                    ],
                    Name: "Vorn Gravelhand",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Torches x16 — 60 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_torches"
                                }
                            ],
                            Label: "buy_torches_button"
                        },
                        {
                            Name: "Coal x8 — 80 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_coal"
                                }
                            ],
                            Label: "buy_coal_button"
                        },
                        {
                            Name: "Iron Ingot — 120 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_iron_ingot"
                                }
                            ],
                            Label: "buy_iron_ingot_button"
                        },
                        {
                            Name: "Rails x8 — 150 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_rails"
                                }
                            ],
                            Label: "buy_rails_button"
                        },
                        {
                            Name: "Iron Pickaxe — 400 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_iron_pickaxe"
                                }
                            ],
                            Label: "buy_iron_pickaxe_button"
                        },
                        {
                            Name: "Back to Vorn",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The shelf. Torches by the bundle because the dark down here is not a metaphor. Coal for the same reason. Iron the assay office weighed and forgot. Rails, straightened personally, mostly by throwing them. And one good pickaxe for when yours gives up in the middle of a wall — they always give up in the middle of a wall."
                        }
                    ],
                    Name: "Vorn — the salvage shelf",
                    Label: "salvage"
                }
            ]
        },
