        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Browse the remedy shelf",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "remedies"
                                }
                            ],
                            Label: "remedies_button"
                        },
                        {
                            Name: "Just passing through",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Marsh-lily brews, fresh-bottled and still glowing! The mart sells medicine for your Pokemon — mine are for YOU. Trainers forget they are also an animal that can drown, freeze, and walk into the dark. The marsh does not forget. Hence the shelf."
                        },
                        {
                            Text: "Everyone acts like the marsh is spooky but I grew up in it and it is only spooky if you are rude to it. Say good morning to the pools, keep a brew in your bag, and nothing out there will ever make you use it. That is marsh logic and it has never once failed me."
                        },
                        {
                            Text: "Oh — do not go past the lamps after dark though. That part is real. That part I do not argue with. It is also, if I am being honest with you, extremely good for potion sales."
                        },
                        {
                            Text: "The fog is mostly Cottonee fluff, you know. It drifts off them while they sleep, that is why it is soft. Everyone acts like I made this up, but nobody can tell me what ELSE fog would be."
                        }
                    ],
                    Name: "Elowen Mistbloom",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Potion of Healing II — 400 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_brew_healing"
                                }
                            ],
                            Label: "buy_healing_button"
                        },
                        {
                            Name: "Potion of Regeneration — 350 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_brew_regen"
                                }
                            ],
                            Label: "buy_regen_button"
                        },
                        {
                            Name: "Night Vision, 8 min — 250 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_brew_nightglow"
                                }
                            ],
                            Label: "buy_nightglow_button"
                        },
                        {
                            Name: "Water Breathing, 8 min — 350 CD",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:economy/market/buy_brew_deepbreath"
                                }
                            ],
                            Label: "buy_deepbreath_button"
                        },
                        {
                            Name: "Back to Elowen",
                            Actions: [
                                {
                                    Type: "OPEN_DEFAULT_DIALOG"
                                }
                            ],
                            Label: "back_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The shelf! Healing is lily-glow bottled at midnight — drink it, do not pour it on your Pokemon, the mart gets very upset when people mix that up. Regeneration is the slow-mend, for after the marsh has had its say. Night vision is the glow itself, eight minutes of seeing what the lamps see. And water breathing — the deep pools are not as empty as they look, and the drowned do not share their air."
                        }
                    ],
                    Name: "Elowen — the brew shelf",
                    Label: "remedies"
                }
            ]
        },
