        DialogData: {
            Type: "CUSTOM",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "sq_museum_donation_done"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "Use the resurrection machine",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "revive"
                                }
                            ],
                            Label: "revive_button"
                        },
                        {
                            Name: "Ask about the machine",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "fossil_lore"
                                }
                            ],
                            Label: "lore_button"
                        },
                        {
                            Name: "Leave",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The comparative anatomy case is complete, and the plinth is not empty anymore - it is full of your bones. That came out wrong. Thank you."
                        },
                        {
                            Text: "Keep brushing the strata. The water is patient and so am I. And when a fossil turns up, the tank behind me is yours - it will wake whatever the sediment kept."
                        }
                    ],
                    Name: "Kenji - exhibit complete",
                    Label: "exhibit_filled"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Take the field brush",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "give @s minecraft:brush 1"
                                },
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "tag @s add sq_museum_brush"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator actionbar [{\"text\":\"Received a brush. Soft gravel waits in the strata below the falls.\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
                                    Type: "PLAYER_TAG",
                                    Operation: "EQUALS",
                                    Name: "no_sq_museum_brush"
                                }
                            ],
                            Label: "brush_button"
                        },
                        {
                            Name: "Where do I dig?",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "dig_directions"
                                }
                            ],
                            Label: "directions_button"
                        },
                        {
                            Name: "Use the resurrection machine",
                            Actions: [
                                {
                                    Type: "OPEN_NAMED_DIALOG",
                                    Cmd: "revive"
                                }
                            ],
                            Label: "revive_button"
                        },
                        {
                            Name: "Just browsing",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Welcome to the Takehara Museum of Natural History - three halls, one curator, and a single empty plinth head office relabeled PENDING RE-VERIFICATION. I preferred the old label. It said DONATED BY FRIENDS."
                        },
                        {
                            Text: "The falls have been cutting these cliffs for ten thousand years. Everything the water uncovers ends up in my strata - what the Company calls pre-verification assets, and I call fossils. Bring me one and the tank will wake it."
                        }
                    ],
                    Name: "Kenji - welcome to natural history",
                    Label: "default"
                },
                {
                    Priority: -1,
                    Buttons: [
                        {
                            Name: "Dome Fossil → Kabuto",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:sidequest/turnin/dome_fossil"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Conditions: [
                                {
