        ],
        Brain: {
            memories: {}
        },
        CanPickUpLoot: 0b,
        CustomNameVisible: 1b,
        DialogData: {
            Type: "STANDARD",
            DialogDataSet: [
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "field_5_liberated"
                        }
                    ],
                    Priority: 40,
                    Buttons: [
                        {
                            Name: "Keep the crossing open",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "Listen to that. Wagons paying nobody. My grandfather ran this crossing on a handshake and a water barrel, and as of today, so do I."
                        },
                        {
                            Text: "The Company clipboard is in my compost, where it is finally improving a yield. Pass through any time - travelers eat free at my crossing, and so do their teams."
                        }
                    ],
                    Name: "Suhail - the crossing runs free",
                    Label: "liberated"
                },
                {
                    Conditions: [
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "defeated_villain_site_manager_5"
                        },
                        {
                            Type: "PLAYER_TAG",
                            Operation: "EQUALS",
                            Name: "no_field_5_liberated"
                        }
                    ],
                    Priority: 30,
                    Buttons: [
                        {
                            Name: "The fence is down - open the crossing",
                            Actions: [
                                {
                                    Type: "COMMAND",
                                    ExecAsUser: 1b,
                                    Cmd: "function cobblemon_initiative:liberation/free_field {field:farm_5}"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator title [{\"text\":\"CROSSROADS GRANARY LIBERATED\",\"color\":\"gold\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "title @initiator subtitle [{\"text\":\"ADJUSTMENT reversed - the parcel is off the ledger and back on the map\",\"color\":\"gray\"}]"
                                },
                                {
                                    Type: "COMMAND",
                                    Cmd: "tellraw @initiator [{\"text\":\"Suhail rips the toll fence out post by post - the Crossroads runs free, and the busiest road in the region owes the Company nothing.\",\"color\":\"green\"}]"
                                },
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "open_gate_button"
                        },
                        {
                            Name: "Hold a moment",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "The Manager walked off the parcel with his clipboard upside down. That means the paper is dead and only the fence is left - and a fence is just wood once nobody official is holding it up. Say the word and I pull it."
                        }
                    ],
                    Name: "Suhail - the fence is down",
                    Label: "fence_down"
                },
                {
                    Priority: 10,
                    Buttons: [
                        {
                            Name: "Look toward the silo",
                            Actions: [
                                {
                                    Type: "CLOSE_DIALOG"
                                }
                            ],
                            Label: "leave_button"
                        }
                    ],
                    Texts: [
                        {
                            Text: "This was my family crossing - the busiest wagon junction in the Reach, which is exactly why the Company wanted it. Now every cart that rolls through pays a little at the fence and nobody quite notices they are being farmed."
                        },
                        {
                            Text: "The Manager by the silo runs the parcel off one clipboard, and the one at the fence keeps the perimeter. Two of them, one of me, and the old boundary stone I used to lean on got hauled off by Company surveyors before you ever walked in."
                        },
                        {
                            Text: "I do not want a war. I want my gate back, my water barrel out front, and travelers who stop because they like the shade. Deal with the clipboards and I will handle the fence myself."
                        },
                        {
                            Text: "Warden Ossa in town keeps the old records that say this land was never theirs to sell. Records are a start. But a record never pulled a fence post."
                        }
                    ],
                    Name: "Suhail",
                    Label: "default"
                }
            ]
        },
